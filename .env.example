# Конфигурация Транскрибатора
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Локальный сервис GigaAM-v3 RNNT (только русская речь)
GIGAAM_SERVICE_PORT=17801

# HuggingFace нужен для Community-1 и сегментации длинных записей
HF_TOKEN=

# Необязательный AI-анализ
GROQ_API_KEY=

# Pi Coding Agent (необязательно; ключи и auth.json сюда не копировать)
PI_ANALYSIS_PROVIDER=openai-codex
PI_ANALYSIS_MODEL=gpt-5.6-sol
PI_ANALYSIS_THINKING=high

# Telegram-бот
TELEGRAM_BOT_TOKEN=

# Ограничения загрузки
MAX_FILE_SIZE_MB=500

# Ollama (если установлен локально)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen:2.5b
