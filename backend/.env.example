# Конфигурация Транскрибатора
# Ключи вводятся через интерфейс приложения (Профиль / Настройки)

NODE_ENV=production
PORT=3000

# HuggingFace — для диаризации спикеров (получить на huggingface.co/settings/tokens)
HF_TOKEN=

# Локальный русскоязычный ASR GigaAM-v3 RNNT
# Модель фиксирована приложением; отдельный API-ключ для транскрибации не нужен.
GIGAAM_SERVICE_PORT=17801

# Не включайте автообновление: устаревшие релизы не должны заменять
# локальную GigaAM-сборку. Ставьте true только после публикации GigaAM-релиза.
ENABLE_AUTO_UPDATE=false

# Pi Coding Agent (необязательно). Авторизация хранится отдельно в
# %USERPROFILE%\.pi\agent\auth.json и никогда не должна попадать в репозиторий.
PI_ANALYSIS_PROVIDER=openai-codex
PI_ANALYSIS_MODEL=gpt-5.6-sol
PI_ANALYSIS_THINKING=high
# PI_CLI_JS=C:\path\to\pi-coding-agent\dist\cli.js
# PI_CODING_AGENT_DIR=C:\path\to\.pi\agent

# Альтернатива Pi: любой OpenAI-совместимый API.
# В установленном приложении ключ хранится зашифрованным через Windows DPAPI.
AI_PROVIDER_MODE=none
CUSTOM_API_ENDPOINT=https://api.openai.com/v1
CUSTOM_API_MODEL=gpt-4o-mini
CUSTOM_API_KEY=

# Telegram бот (получить токен у @BotFather)
TELEGRAM_BOT_TOKEN=

# Ollama (если установлен локально)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen:2.5b
